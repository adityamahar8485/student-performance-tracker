# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas - create a free M0 cluster at https://cloud.mongodb.com
# Database user: Atlas > Security > Database Users (readWrite role)
# Network access: 0.0.0.0/0 required for Render deployments
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=7d

# Admin seeder (npm run seed) - password is bcrypt-hashed before saving
ADMIN_NAME=Aditya Mahar
ADMIN_EMAIL=adityamahar8485@gmail.com
ADMIN_PASSWORD=<set_me_before_seeding>

# CORS - frontend origin
CLIENT_URL=http://localhost:5173
